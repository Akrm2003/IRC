import { getTournament, submitMatchResult } from '../services/tournamentService';
import { Tournament, TournamentMatch } from './types';

let currentMatchId: string | null = null;

export function initializeTournamentDetail() {
  console.log('Initializing tournament detail view...');
  
  const urlParams = new URLSearchParams(window.location.search);
  const tournamentId = urlParams.get('id');
  
  if (!tournamentId) {
    console.error('No tournament ID provided');
    showError('Tournament not found');
    return;
  }

  loadTournamentDetails(tournamentId);
  setupEventListeners(tournamentId);
}

function setupEventListeners(tournamentId: string) {
  // Back to list button
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    
    if (target.id === 'backToList') {
      // Hide tournament detail and show list
      const tournamentsList = document.getElementById('tournamentsList');
      const tournamentDetail = document.getElementById('tournamentDetail');
      
      if (tournamentsList && tournamentDetail) {
        tournamentDetail.classList.add('hidden');
        tournamentsList.classList.remove('hidden');
        
        // Update URL
        window.history.pushState({}, '', window.location.pathname);
      }
    }
    
    if (target.classList.contains('play-match-btn')) {
      const matchId = target.getAttribute('data-match-id');
      const player1 = target.getAttribute('data-player1');
      const player2 = target.getAttribute('data-player2');
      const tournamentId = target.getAttribute('data-tournament-id');
      
      if (matchId && player1 && player2 && tournamentId) {
        startPongMatch(matchId, player1, player2, tournamentId);
      }
    }
  });
}

// Function to start a Pong match - ready for game integration
async function startPongMatch(matchId: string, player1: string, player2: string, tournamentId: string) {
  console.log('Starting Pong match:', { matchId, player1, player2, tournamentId });
  
  // Show match preparation modal
  showMatchPreparationModal(player1, player2, async (winner: string, score1: number, score2: number) => {
    try {
      // Submit the match result
      await submitMatchResult(tournamentId, matchId, score1, score2);
      
      // Reload tournament to show updated bracket
      await loadTournamentDetails(tournamentId);
      
      // Show success message
      showMatchCompletedMessage(winner);
      
    } catch (error) {
      console.error('Failed to submit match result:', error);
      showError('Failed to submit match result');
    }
  });
  
  // TODO: When Pong game is available, replace the modal with:
  // 1. Navigate to Pong game with tournament context
  // 2. Pass match details (matchId, player1, player2, tournamentId)
  // 3. Game will call back with results when finished
  
  // Example integration code (uncomment when Pong is ready):
  /*
  const gameUrl = `/game/pong?mode=tournament&matchId=${matchId}&player1=${encodeURIComponent(player1)}&player2=${encodeURIComponent(player2)}&tournamentId=${tournamentId}`;
  window.location.href = gameUrl;
  */
}

// Temporary modal for match simulation (until Pong game is integrated)
function showMatchPreparationModal(player1: string, player2: string, onComplete: (winner: string, score1: number, score2: number) => void) {
  const modal = document.createElement('div');
  modal.className = 'fixed inset-0 z-50 flex items-center justify-center p-4';
  modal.innerHTML = `
    <!-- Background overlay -->
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm"></div>
    
    <!-- Modal content -->
    <div class="relative bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl shadow-2xl border border-yellow-400/30 max-w-md w-full p-8">
      <div class="text-center">
        <div class="text-6xl mb-4">🏓</div>
        <h2 class="text-2xl font-bold text-yellow-400 mb-4">PONG MATCH</h2>
        
        <div class="bg-black/50 rounded-lg p-4 mb-6">
          <div class="flex items-center justify-between text-lg font-bold text-white">
            <span>${player1}</span>
            <span class="text-yellow-400">VS</span>
            <span>${player2}</span>
          </div>
        </div>
        
        <p class="text-slate-300 mb-6">
          Ready to play? The Pong game will launch and track the match results automatically.
        </p>
        
        <!-- Temporary simulation buttons (remove when Pong is integrated) -->
        <div class="space-y-3 mb-6">
          <p class="text-sm text-slate-400">Temporary: Simulate match result</p>
          <div class="flex gap-2">
            <button class="simulate-btn flex-1 bg-gradient-to-r from-blue-500 to-blue-600 text-white py-2 px-4 rounded-lg font-medium" data-winner="${player1}">
              ${player1} Wins
            </button>
            <button class="simulate-btn flex-1 bg-gradient-to-r from-red-500 to-red-600 text-white py-2 px-4 rounded-lg font-medium" data-winner="${player2}">
              ${player2} Wins
            </button>
          </div>
        </div>
        
        <div class="flex gap-3">
          <button id="cancelMatch" class="flex-1 bg-slate-700 hover:bg-slate-600 text-white py-3 px-4 rounded-lg font-medium">
            Cancel
          </button>
          <button id="startPongGame" class="flex-1 bg-gradient-to-r from-yellow-600 to-yellow-500 hover:from-yellow-500 hover:to-yellow-400 text-black py-3 px-4 rounded-lg font-bold">
            🚀 Start Game
          </button>
        </div>
      </div>
    </div>
  `;

  document.body.appendChild(modal);

  // Event listeners
  const simulateButtons = modal.querySelectorAll('.simulate-btn');
  simulateButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const winner = btn.getAttribute('data-winner') || '';
      const score1 = winner === player1 ? 11 : Math.floor(Math.random() * 10);
      const score2 = winner === player2 ? 11 : Math.floor(Math.random() * 10);
      
      document.body.removeChild(modal);
      onComplete(winner, score1, score2);
    });
  });

  modal.querySelector('#cancelMatch')?.addEventListener('click', () => {
    document.body.removeChild(modal);
  });

  modal.querySelector('#startPongGame')?.addEventListener('click', () => {
    // TODO: Launch actual Pong game here
    alert('Pong game integration coming soon! Use simulation buttons for now.');
  });
}

// Show success message after match completion
function showMatchCompletedMessage(winner: string) {
  const successDiv = document.createElement('div');
  successDiv.className = 'fixed top-4 right-4 bg-gradient-to-r from-green-500 to-green-600 text-white px-6 py-4 rounded-lg shadow-lg z-50 transform transition-all duration-300';
  successDiv.innerHTML = `
    <div class="flex items-center gap-3">
      <span class="text-2xl">🏆</span>
      <div>
        <div class="font-bold">Match Complete!</div>
        <div class="text-sm opacity-90">${winner} advances to the next round</div>
      </div>
    </div>
  `;
  
  document.body.appendChild(successDiv);
  
  setTimeout(() => {
    successDiv.style.transform = 'translateX(100%)';
    setTimeout(() => {
      if (document.body.contains(successDiv)) {
        document.body.removeChild(successDiv);
      }
    }, 300);
  }, 4000);
}

async function loadTournamentDetails(tournamentId: string) {
  const container = document.getElementById('tournamentDetail');
  if (!container) {
    console.error('Tournament detail container not found');
    return;
  }

  try {
    container.innerHTML = `
      <div class="flex justify-center items-center h-64">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-500"></div>
      </div>
    `;

    const tournament = await getTournament(tournamentId);
    displayTournamentDetails(tournament);
  } catch (error) {
    console.error('Failed to load tournament:', error);
    showError('Failed to load tournament details');
  }
}

function displayTournamentDetails(tournament: Tournament) {
  const container = document.getElementById('tournamentDetail');
  if (!container) return;

  const matchesByRound: Record<number, TournamentMatch[]> = {};
  tournament.matches.forEach(match => {
    if (!matchesByRound[match.roundNumber]) {
      matchesByRound[match.roundNumber] = [];
    }
    matchesByRound[match.roundNumber].push(match);
  });

  const maxRounds = Math.max(...Object.keys(matchesByRound).map(Number));

  container.innerHTML = `
    <!-- Tournament Header -->
    <div class="tournament-card p-6 mb-8">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-4">
          <button
            id="backToList"
            class="flex items-center gap-2 px-4 py-2 bg-slate-700/50 hover:bg-slate-600/50 text-white rounded-lg transition-all duration-300"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Tournaments
          </button>
          
          <div class="h-8 w-px bg-slate-600"></div>
          
          <div>
            <h1 class="text-2xl font-bold text-white flex items-center gap-3">
              🏆 ${tournament.name}
            </h1>
            <p class="text-slate-400 text-sm">
              Created ${new Date(tournament.createdAt).toLocaleDateString()} • ${tournament.players?.length || 0} players
            </p>
          </div>
        </div>
        
        <div class="flex items-center gap-3">
          <span class="status-badge px-4 py-2 rounded-full text-sm font-semibold ${getStatusClass(tournament.status)}">
            ${getStatusText(tournament.status)}
          </span>
        </div>
      </div>

      ${tournament.status === 'COMPLETED' && tournament.winnerName ? `
        <div class="champion-crown p-8 text-center">
          <div class="text-6xl mb-4">👑</div>
          <h2 class="text-2xl font-bold text-yellow-300 mb-2">TOURNAMENT CHAMPION</h2>
          <p class="text-3xl font-black text-yellow-400 mb-2">${tournament.winnerName}</p>
          <div class="flex justify-center items-center gap-2 text-yellow-300">
            <span class="text-lg">🏆</span>
            <span class="text-sm font-medium">VICTORY ACHIEVED</span>
            <span class="text-lg">🏆</span>
          </div>
        </div>
      ` : ''}
    </div>

    <!-- Tournament Bracket -->
    <div class="bracket-container">
      <div class="flex items-center justify-center gap-4 mb-8">
        <div class="w-16 h-1 bg-gradient-to-r from-transparent via-yellow-400 to-transparent"></div>
        <div class="flex items-center gap-3">
          <span class="text-3xl">⚔️</span>
          <h2 class="text-2xl font-bold text-yellow-400 tracking-wider">CHAMPIONSHIP BRACKET</h2>
          <span class="text-3xl">⚔️</span>
        </div>
        <div class="w-16 h-1 bg-gradient-to-r from-transparent via-yellow-400 to-transparent"></div>
      </div>
      
      <div class="overflow-x-auto">
        <div class="flex gap-16 min-w-max pb-8 justify-center">
          ${Object.entries(matchesByRound).map(([round, matches], roundIndex) => `
            <div class="flex flex-col items-center min-w-[280px]">
              <!-- Round Header -->
              <div class="mb-8 text-center">
                <div class="round-header inline-flex items-center gap-3 px-6 py-3">
                  <span class="text-2xl">
                    ${round === '1' ? '🥊' : 
                      round === String(maxRounds) ? '👑' : 
                      round === String(maxRounds - 1) ? '🏅' : '⚔️'}
                  </span>
                  <span class="font-bold text-yellow-300 text-lg tracking-wider">
                    ${round === '1' ? 'FIRST ROUND' : 
                      round === String(maxRounds) ? 'GRAND FINAL' : 
                      round === String(maxRounds - 1) ? 'SEMI-FINAL' : 
                      `ROUND ${round}`}
                  </span>
                </div>
              </div>
              
              <!-- Matches -->
              <div class="space-y-8 flex-1">
                ${matches.map((match, matchIndex) => `
                  <div class="bracket-match p-4 ${match.match.winnerName && match.match.winnerName !== 'TBD' ? 'winner-glow' : ''}">
                    <!-- Match Header -->
                    <div class="flex items-center justify-between mb-4">
                      <span class="text-xs font-bold text-yellow-400 uppercase tracking-widest">
                        MATCH ${match.matchNumber}
                      </span>
                      ${match.match.winnerName && match.match.winnerName !== 'TBD' ? `
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-yellow-500/20 text-yellow-400 border border-yellow-500/40">
                          ✅ COMPLETE
                        </span>
                      ` : match.player1Name !== 'TBD' && match.player2Name !== 'TBD' && match.player2Name !== 'BYE' ? `
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-orange-500/20 text-orange-400 border border-orange-500/40">
                          ⏳ READY
                        </span>
                      ` : `
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-gray-500/20 text-gray-400 border border-gray-500/40">
                          ⏸️ WAITING
                        </span>
                      `}
                    </div>
                    
                    <!-- Players -->
                    <div class="space-y-3 mb-6">
                      <!-- Player 1 -->
                      <div class="player-slot ${
                        match.match.winnerName === match.player1Name ? 'winner' : ''
                      } flex items-center justify-between p-4 rounded-lg">
                        <div class="flex items-center gap-3">
                          ${match.match.winnerName === match.player1Name ? '👑' : '⚔️'}
                          <span class="font-bold text-lg ${
                            match.match.winnerName === match.player1Name ? 'text-yellow-400' : 'text-white'
                          }">
                            ${match.player1Name === 'TBD' ? '🔄 TBD' : match.player1Name}
                          </span>
                        </div>
                        <span class="text-2xl font-black ${
                          match.match.winnerName === match.player1Name ? 'text-yellow-400' : 'text-white'
                        }">
                          ${match.match.score_p1 || 0}
                        </span>
                      </div>
                      
                      <!-- VS Divider -->
                      <div class="text-center py-2">
                        <div class="inline-flex items-center justify-center w-12 h-12 bg-gradient-to-r from-yellow-600/20 to-yellow-400/20 border-2 border-yellow-400/30 rounded-full">
                          <span class="text-sm font-black text-yellow-400 tracking-wider">VS</span>
                        </div>
                      </div>
                      
                      <!-- Player 2 -->
                      <div class="player-slot ${
                        match.player2Name && match.match.winnerName === match.player2Name ? 'winner' : ''
                      } flex items-center justify-between p-4 rounded-lg">
                        <div class="flex items-center gap-3">
                          ${match.player2Name && match.match.winnerName === match.player2Name ? '👑' : 
                            match.player2Name === 'BYE' ? '🚫' : '⚔️'}
                          <span class="font-bold text-lg ${
                            match.player2Name && match.match.winnerName === match.player2Name ? 'text-yellow-400' : 'text-white'
                          }">
                            ${match.player2Name === 'TBD' ? '🔄 TBD' : 
                              match.player2Name === 'BYE' ? '🚫 BYE' : 
                              match.player2Name || '🔄 TBD'}
                          </span>
                        </div>
                        <span class="text-2xl font-black ${
                          match.player2Name && match.match.winnerName === match.player2Name ? 'text-yellow-400' : 'text-white'
                        }">
                          ${match.match.score_p2 || 0}
                        </span>
                      </div>
                    </div>

                    <!-- Action Button -->
                    ${match.match.winnerName === 'TBD' && match.player1Name !== 'TBD' && match.player2Name !== 'TBD' && match.player2Name !== 'BYE' ? `
                      <button
                        class="play-match-btn w-full bg-gradient-to-r from-yellow-600 to-yellow-500 hover:from-yellow-500 hover:to-yellow-400 text-black font-black py-4 px-6 rounded-xl transition-all duration-300 shadow-lg hover:shadow-2xl transform hover:scale-105 flex items-center justify-center gap-3 border-2 border-yellow-400/50"
                        data-match-id="${match.matchId}"
                        data-player1="${match.player1Name}"
                        data-player2="${match.player2Name}"
                        data-tournament-id="${tournament.id}"
                      >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h.01M15 14h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        🏓 PLAY MATCH
                      </button>
                    ` : match.match.winnerName && match.match.winnerName !== 'TBD' ? `
                      <div class="text-center py-3">
                        <div class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-yellow-500/20 to-yellow-400/20 border border-yellow-400/40 rounded-lg">
                          <span class="text-lg">🏆</span>
                          <span class="text-sm font-bold text-yellow-400 tracking-wider">
                            WINNER: ${match.match.winnerName}
                          </span>
                          <span class="text-lg">🏆</span>
                        </div>
                      </div>
                    ` : `
                      <div class="text-center py-3">
                        <span class="text-sm text-gray-400 font-medium">
                          ${match.player1Name === 'TBD' || match.player2Name === 'TBD' ? 
                            '⏳ WAITING FOR PREVIOUS MATCHES' : 
                            '🎮 READY TO BATTLE'}
                        </span>
                      </div>
                    `}
                  </div>
                `).join('')}
              </div>
            </div>
            
            <!-- Connection Lines (except for last round) -->
            ${roundIndex < Object.keys(matchesByRound).length - 1 ? `
              <div class="flex items-center justify-center w-8">
                <svg class="w-full h-full" viewBox="0 0 32 200">
                  ${matches.map((_, matchIndex) => {
                    const y = 50 + (matchIndex * 100);
                    return `
                      <path class="bracket-line" d="M 0 ${y} L 16 ${y} L 16 ${y + 50} L 32 ${y + 50}" />
                    `;
                  }).join('')}
                </svg>
              </div>
            ` : ''}
          `).join('')}
        </div>
      </div>
    </div>

    <div id="scoreModal" class="hidden fixed z-10 inset-0 overflow-y-auto">
      <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 transition-opacity" aria-hidden="true">
          <div class="absolute inset-0 bg-gray-500 opacity-75"></div>
        </div>
        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
          <form id="scoreForm" class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
            <div class="sm:flex sm:items-start">
              <div class="mt-3 text-center sm:mt-0 sm:text-left w-full">
                <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Submit Match Score</h3>
                <div class="mt-2 space-y-4">
                  <div>
                    <label class="block text-sm font-medium text-gray-700">Player 1 Score</label>
                    <input type="number" id="score1" name="score1" min="0" required
                           class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700">Player 2 Score</label>
                    <input type="number" id="score2" name="score2" min="0" required
                           class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                  </div>
                </div>
              </div>
            </div>
            <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
              <button type="submit" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-indigo-600 text-base font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:ml-3 sm:w-auto sm:text-sm">
                Submit
              </button>
              <button type="button" id="cancelScore" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                Cancel
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div id="scoreModal" class="hidden fixed z-10 inset-0 overflow-y-auto">
      <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 transition-opacity" aria-hidden="true">
          <div class="absolute inset-0 bg-gray-500 opacity-75"></div>

    if (currentMatchId) {
      try {
        await submitMatchResult(tournamentId, currentMatchId, score1, score2);
        hideScoreModal();
        loadTournamentDetails(tournamentId);
      } catch (error) {
        console.error('Failed to submit match result:', error);
        showError('Failed to submit match result');
      }
    }
  });

  document.getElementById('cancelScore')?.addEventListener('click', hideScoreModal);
}

function showScoreModal() {
  const modal = document.getElementById('scoreModal');
  if (modal) {
    modal.classList.remove('hidden');
  }
}

function hideScoreModal() {
  const modal = document.getElementById('scoreModal');
  if (modal) {
    modal.classList.add('hidden');
  }
  currentMatchId = null;
}

function getStatusClass(status: string): string {
  switch (status) {
    case 'COMPLETED':
      return 'bg-green-500/20 text-green-400 border border-green-500/30';
    case 'IN_PROGRESS':
      return 'bg-blue-500/20 text-blue-400 border border-blue-500/30';
    default:
      return 'bg-yellow-500/20 text-yellow-400 border border-yellow-500/30';
  }
}

function getStatusText(status: string): string {
  switch (status) {
    case 'COMPLETED':
      return '✅ Completed';
    case 'IN_PROGRESS':
      return '🎮 In Progress';
    case 'UPCOMING':
      return '⏳ Upcoming';
    default:
      return status.replace('_', ' ');
  }
}

function showError(message: string) {
  const container = document.getElementById('tournamentDetail');
  if (!container) return;

  container.innerHTML = `
    <div class="tournament-card p-8 text-center">
      <div class="text-6xl mb-4">❌</div>
      <h3 class="text-xl font-bold text-white mb-2">Error</h3>
      <p class="text-slate-400 mb-6">${message}</p>
      <button 
        onclick="window.location.href='/tournaments'" 
        class="bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white font-bold py-3 px-6 rounded-xl transition-all duration-300"
      >
        ← Back to Tournaments
      </button>
    </div>
  `;
}
